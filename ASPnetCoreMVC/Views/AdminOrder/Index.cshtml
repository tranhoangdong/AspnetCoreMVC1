@model List<OrderIndexViewModel>

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
</head>
<body>
    <form class="search-order">
        <div class="form-group">
            <label for="name">ID bàn:</label>
            <input type="text" id="idban" name="name" class="form-control" placeholder="Nhập Id bàn..." />
        </div>
        <div class="form-group">
            <label for="idban">Mã đơn hàng:</label>
            <input type="text" id="idOrder" name="name" class="form-control" placeholder="Nhập mã đơn hàng ..." />
        </div>
        <button type="submit" class="btn btn-primary search-order">Tìm kiếm</button>
    </form>

    <div class="container">
        <h2>Danh sách sản phẩm</h2>
        <div id="OrderTableContainer"></div>
    </div>


    <script>

    $(document).ready(function () {
        function loadOrder() {
            var idban = $('#idban').val();
            var idOrder = $('#idOrder').val();
            console.log("idban:", idban, "idOrder:", idOrder);
            $.ajax({
                url: '@Url.Action("LoadOrder", "AdminOrder")',
                type: 'GET',
                data: {
                    idban: idban,
                    idOrder: idOrder
                },
                success: function (data) {
                    $('#OrderTableContainer').html(data);
                },
                error: function () {
                    alert('Có lỗi xảy ra khi tải danh sách sản phẩm.');
                }

            });
        };

        loadOrder();

        $('.search-order').on('click', function (e) {
            e.preventDefault();
            loadOrder();
        });

    });

    </script>
</body>
</html>