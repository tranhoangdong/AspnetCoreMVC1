@model List<OrderIndexViewModel>

<h2>Quản lý đơn hàng</h2>

<table class="table">
    <thead>
        <tr>
            <th>Mã đơn hàng</th>
            <th>Bàn</th>
            <th>Tổng tiền</th>
            <th>Thời gian đặt</th>
            <th>Trạng thái</th>
            <th>Hành động</th>
            <th>Xem chi tiết đơn hàng</th>
            <th>In</th>

        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
        <tr>
            <td>@order.Id</td>
            <td>@order.RoomAndTableId</td>
            <td>@order.TotalAmount</td>
            <td>@order.OrderTime</td>
            <td>@(order.IsPaid ? "Đã thanh toán" : "Chưa thanh toán")</td>
            <td>
                @if (!order.IsPaid)
                {
                    <form asp-action="PayOrder" method="post">
                        <input type="hidden" name="id" value="@order.Id" />
                        <button type="submit">Thanh toán</button>
                    </form>}
            </td>
            <td>
                <button class="btn btn-info view-details" data-id="@order.Id">Xem chi tiết</button>
            </td>
            <td>
                <button onclick="window.location.href='@Url.Action("ExportOrderDetailsToWord", "AdminOrder", new { orderId = order.Id })'">
                    In ra Word
                </button>
            </td>
            <td>
                <button onclick="window.location.href='@Url.Action("ExportOrderDetailsToPdf", "AdminOrder", new { orderId = order.Id })'">
                    Xuất ra PDF
                </button>
            </td>

        </tr>
        }
    </tbody>
</table>
