@model IEnumerable<WishlistViewModel>

<h2>Danh sách yêu thích</h2>

@if (!Model.Any())
{
    <p>Không có sản phẩm nào trong danh sách yêu thích!</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Tên sản phẩm</th>
                <th>Giá</th>
                <th>Ngày thêm</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.ProductName</td>
                    <td>@product.ProductPrice.ToString("C")</td>
                    <td>@product.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <button class="btn btn-danger remove-wishlist" data-id="@product.ProductId">Xóa</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
