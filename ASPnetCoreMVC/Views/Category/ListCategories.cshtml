@model List<CategoryViewModel>

    <h2>Danh sách danh mục</h2>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>STT</th>
                <th>Id</th>
                <th>Name</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
            int index = 1;
            foreach (var category in Model)
            {
            <tr>
                <td>@index</td>
                <td>@category.Id</td>
                <td>@category.Name</td>
            </tr>
            index++;
            }
            }
            else
            {
            <tr>
                <td colspan="3" class="text-center">Không có danh mục nào.</td>
            </tr>
            }
        </tbody>
    </table>
