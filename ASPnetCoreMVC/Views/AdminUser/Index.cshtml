@model eShopSolution.Web.Models.AllUserViewModel
    <!DOCTYPE html>
    <html>
    <head>
        <meta charset="utf-8" />


    </head>
    <body>
        <div class="container mt-4">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3>Danh sách User</h3>
            </div>
            <div class="modal fade" id="addEmployeeModal" tabindex="-1" role="dialog" aria-labelledby="addEmployeeModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="addEmployeeModalLabel">Thêm Nhân viên</h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body">
                            <div id="modalContent">
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label for="UserName">Tên User:</label>
                        <input type="text" id="SearchName" name="UserName" class="form-control" placeholder="Tìm kiếm User..." />
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <label for="Name">Chọn role: </label>
                        <div class="col-sm-10">
                            <select id="SearchRoleDropdown" class="form-control">
                                <option value="">-- Chọn Role --</option>
                                @foreach (var role in Model.Roles)
                                {
                                    <option value="@role.RoleId">@role.RoleName</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                
            </div>
               
                <button type="submit" id="searchUser" class="btn btn-primary search-search-bar">Tìm kiếm</button>


            <div class="card">
                <div class="card-body">
                    <div class="modal-body">
                        <div id="modalContent">
                        </div>
                    </div>
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>User Name</th>
                                <th>Email</th>
                                <th>Phone Number</th>
                                <th>Roles</th>
                                <th width="300">Action</th>
                            </tr>
                        </thead>

                        <tbody id="userTableBody">
                            @foreach (var user in Model.Userviewmodel)
                            {
                                <tr>
                                    <td>@user.UserName</td>
                                    <td>@user.Email</td>
                                    <td>@user.PhoneNumber</td>
                                    <td>@user.Role</td>


                                    <td>
                                        <button class="btn btn-sm btn-warning btn-edit-employee" 
                                                data-userid="@user.UserId">
                                            Edit
                                        </button>
                                        <a class="btn btn-sm btn-danger"
                                           asp-action="Delete"
                                           asp-route-id="@user.UserName">
                                            Delete
                                        </a>
                                        <button class="btn btn-sm btn-success btn-add-employee"
                                                data-userid="@user.UserId">
                                            + Employee
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <script>
                $(document).on('click', '.btn-add-employee', function () {
                    var userId = $(this).data('userid');
                    $.ajax({
                        url: '@Url.Action("AddEmployee", "AdminUser")' + '?userId=' + userId,
                        type: 'GET',
                        success: function (data) {
                            console.log("Form đã được tải thành công");
                            $('#modalContent').html(data);
                            $('#addEmployeeModal').modal('show');
                        },
                        error: function () {
                            alert('Có lỗi xảy ra, vui lòng thử lại.');
                        }
                    });
                });

                      $(document).on('click', '#submitUser', function () {
                            var formData = {
                                UserId:      $('#UserId').val(),
                                UserName:    $('#UserName').val(),
                                Email:       $('#Email').val(),
                                PhoneNumber: $('#PhoneNumber').val(),
                                RoleId:      $('#RoleDropdown').val(),
                                Position:    $('#Position').val(),
                                Salary:      parseFloat($('#Salary').val()) || 0
                            };

                            $.ajax({
                                url:         '/AdminUser/AddEmployee',
                                type:        'POST',
                                contentType: 'application/json',
                                data:        JSON.stringify(formData),
                                success: function (response) {
                                    console.log("Form submitted successfully");
                                    $('#addEmployeeModal').modal('hide');
                                    location.reload();
                                },
                                error: function () {
                                    alert('Có lỗi xảy ra! Vui lòng thử lại.');
                                }
                            });
                      });

                        $(document).on('click', '.btn-edit-employee', function () {
                            var userId = $(this).data('userid');
                            $.ajax({
                                    url: '@Url.Action("EditEmployee", "AdminUser")',
                                    type: 'GET',
                                    data: { userId: userId }, 
                                success: function (data) {
                                    console.log("Form đã được tải thành công");
                                    $('#modalContent').html(data);
                                    $('#addEmployeeModal').modal('show');
                                },
                                error: function () {
                                    alert('Có lỗi xảy ra, vui lòng thử lại.');

                                }
                            });
                        });

                        $(document).on('click', '#submitEditUser', function (e) {
                            e.preventDefault();
                            var formData  = {
                                UserId: $('#UserId').val(),
                                UserName: $('#UserName').val(),
                                Email: $('#Email').val(),
                                PhoneNumber: $('#PhoneNumber').val(),
                                RoleId: $('#RoleDropdown').val()
                            };
                            $.ajax({
                                url: '/AdminUser/EditEmployee',
                                type: 'POST',
                                contentType: 'application/json',
                                data: JSON.stringify(formData),
                                success: function (response) {
                                    console.log("Form submitted successfully");
                                    $('#addEmployeeModal').modal('hide');
                                    location.reload();
                                },
                                error: function () {
                                    alert('Có lỗi xảy ra! Vui lòng thử lại.');
                                }
                            });

                        });
                        function loadUser(){
                            var formData = {
                                userName: $('#SearchName').val(),
                                roleId: $('#SearchRoleDropdown').val(),
                            };
                            $.ajax({
                                url: '/AdminUser/LoadUser',
                                type: 'GET',
                                data: formData,
                                success: function (response) {
                                    console.log("Form submitted successfully");
                                    $('#userTableBody').html(response);
                                },
                                error: function () {
                                    alert('Có lỗi xảy ra! Vui lòng thử lại.');
                                }
                            });
                        }
                    $(document).on('click', '#searchUser', function (e) {
                        e.preventDefault();
                        loadUser();
                    });
                    $('#SearchName').on('keyup', function () {
                            loadUser();
                        });
                        $('#SearchRoleDropdown').on('change', function () {
                            loadUser();
                        });

                    </script>
                </div>
            </div>
        </div>
    </body>
</html>