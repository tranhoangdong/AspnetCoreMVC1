@model eShopSolution.Web.Models.AllUserViewModel

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Danh sách User</h3>
    </div>
    <div class="modal fade" id="addEmployeeModal" tabindex="-1" role="dialog" aria-labelledby="addEmployeeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addEmployeeModalLabel">Thêm Nhân viên</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div id="modalContent">
                    </div>
                </div>

            </div>
        </div>
    </div>
    <form class="search-bar">
        <div class="form-group">
            <label for="UserName">Tên User:</label>
            <input type="text" id="UserName" name="UserName" class="form-control" placeholder="Tìm kiếm User..." />
        </div>
        <select id="roleDropdown" name="roleId" class="form-control">
            <option value="">-- Chọn --</option>
           
        </select>
        <button type="submit" class="btn btn-primary search-search-bar">Tìm kiếm</button>

    </form>
        <div class="card">
            <div class="card-body">
                <div class="modal-body">
                    <div id="modalContent">
                    </div>
                </div>
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>User Name</th>
                            <th>Email</th>
                            <th>Phone Number</th>
                            <th>Roles</th>
                            <th width="300">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var user in Model.Userviewmodel)
                        {
                            <tr>
                                <td>@user.UserName</td>
                                <td>@user.Email</td>
                                <td>@user.PhoneNumber</td>
                                <td>@user.Role</td>


                                <td>
                                    <a class="btn btn-sm btn-warning"
                                       asp-action="Edit"
                                       asp-route-id="@user.UserName">
                                        Edit
                                    </a>

                                    <a class="btn btn-sm btn-danger"
                                       asp-action="Delete"
                                       asp-route-id="@user.UserName">
                                        Delete
                                    </a>
                                    <button class="btn btn-sm btn-success btn-add-employee"
                                            data-userid="@user.UserId">
                                        + Employee
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <script>
                $(document).on('click', '.btn-add-employee', function () {
                    var userId = $(this).data('userid');
                    $.ajax({
                        url: '@Url.Action("AddEmployee", "AdminUser")' + '?userId=' + userId,
                        type: 'GET',
                        success: function (data) {
                            console.log("Form đã được tải thành công");
                            $('#modalContent').html(data);
                            $('#addEmployeeModal').modal('show');
                        },
                        error: function () {
                            alert('Có lỗi xảy ra, vui lòng thử lại.');
                        }
                    });
                });

                      $(document).on('click', '#submitUser', function () {
                            var formData = {
                                UserId:      $('#UserId').val(),
                                UserName:    $('#UserName').val(),
                                Email:       $('#Email').val(),
                                PhoneNumber: $('#PhoneNumber').val(),
                                RoleId:      $('#RoleId').val(),
                                Position:    $('#Position').val(),
                                Salary:      parseFloat($('#Salary').val()) || 0
                            };

                            $.ajax({
                                url:         '/AdminUser/AddEmployee',
                                type:        'POST',
                                contentType: 'application/json',
                                data:        JSON.stringify(formData),
                                success: function (response) {
                                    console.log("Form submitted successfully");
                                    $('#addEmployeeModal').modal('hide');
                                    location.reload();
                                },
                                error: function () {
                                    alert('Có lỗi xảy ra! Vui lòng thử lại.');
                                }
                            });
                        });

                    $(document).on('click', '.search-search-bar', function () {
                        var formData = {
                            UserName: $('#UserName').val(),
                            Id: $('#roleDropdown').val(),
                        };
                        $.ajax({
                            url: '/AdminUser/LoadUser',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(formData),
                            success: function (response) {
                                console.log("Form submitted successfully");
                                $('#addEmployeeModal').modal('hide');
                                location.reload();
                            },
                            error: function () {
                                alert('Có lỗi xảy ra! Vui lòng thử lại.');
                            }
                        });
                    });
                </script>
            </div>
        </div>
</div>