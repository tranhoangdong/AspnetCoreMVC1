@model eShopSolution.Web.Models.PromoteEmployeeViewModel
<input type="hidden" id="UserId" name="UserId" asp-for="UserId" />
<div class="form-group row">
    <label for="Name" class="col-sm-2 col-form-label">Tên: </label>
    <div class="col-sm-10">
        <input type="text" id="UserName" name="UserName" asp-for="UserName" class="form-control" readonly />
    </div>
</div>
<div class="form-group row">
    <label for="Email" class="col-sm-2 col-form-label">Email: </label>
    <div class="col-sm-10">
        <input type="Email" id="Email" name="Email" asp-for="Email" class="form-control" readonly />
    </div>
</div>
<div class="form-group row">
    <label for="PhoneNumber" class="col-sm-2 col-form-label">Số điện thoại: </label>
    <div class="col-sm-10">
        <input type="number" id="PhoneNumber" name="PhoneNumber" asp-for="PhoneNumber" class="form-control" required />
    </div>
</div>
<div class="form-group row">
    <label for="Name" class="col-sm-2 col-form-label">Chọn role: </label>
    <div class="col-sm-10">
        <select id="RoleDropdown" name="RoleId" asp-for="Role.RoleId" class="form-control">
            <option value="">-- Chọn Role --</option>
            @foreach (var role in Model.Roles)
            {
                <option value="@role.RoleId">@role.RoleName</option>
            }
        </select>
        </div>
    </div>
    <div class="form-group row">
        <label for="Position" class="col-sm-2 col-form-label">Vị trí: </label>
        <div class="col-sm-10">
            <input type="text" id="Position" name="Position" asp-for="Position" class="form-control" required />
        </div>
    </div>    <div class="form-group row">
        <label for="Salary" class="col-sm-2 col-form-label">Lương: </label>
        <div class="col-sm-10">
            <input type="number" id="Salary" name="Salary" asp-for="Salary" class="form-control" min="0" step="1000" required />
        </div>
    </div>
    <div class="form-group row">
        <div class="col-sm-10 offset-sm-2">
            <button type="submit" class="btn btn-success" id="submitUser">Cập nhật</button>
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
        </div>
    </div>
